# Copy to .env and fill in. .env is gitignored.

# --- Required ----------------------------------------------------------
# Fine-grained PAT. Organization permissions:
#   Members: read, Administration: read, Dependabot alerts: read
# Repository permissions:
#   Metadata: read, Contents: read, Pull requests: read, Administration: read
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=your-org-login

# --- Scan window and repo selection ------------------------------------
LOOKBACK_DAYS=180
SKIP_FORKS=true
SKIP_ARCHIVED=false
REPO_VISIBILITY=all
# MAX_REPOS=10
# REPO_ALLOWLIST=service-a,service-b
# REPO_DENYLIST=sandbox

# --- Scoring -----------------------------------------------------------
# Flag a member when their score falls below this.
# Reference points: 1 recent commit = 2.08, 5 = 5.37, 10 = 7.19
SCORE_THRESHOLD=5.0
HALF_LIFE_DAYS=180
# WEIGHT_COMMITS=3.0
# WEIGHT_REVIEWS=2.5
# WEIGHT_PRS_MERGED=2.0
# WEIGHT_PRS_OPENED=1.0

# --- Never flag these ---------------------------------------------------
# Org owners and bots are excluded automatically; list extra logins here.
LOGIN_ALLOWLIST=
MIN_CONTRIBUTORS=2

# --- HTTP ---------------------------------------------------------------
RATE_LIMIT_MIN_REMAINING=50
USE_ETAG_CACHE=true
ORG_DEPENDABOT_FIRST=true
LOG_LEVEL=INFO

# --- Paths --------------------------------------------------------------
# DB_PATH=data/scanner.sqlite3
# REPORT_PATH=out/dashboard.html
